{
  "name": "remedy-calendar",
  "version": "1.0.0",
  "description": "Ultra-fast calendar generator with intelligent caching system for TypeScript/JavaScript applications",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "vite demo --open",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:legacy": "node test.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "calendar",
    "date",
    "week",
    "month",
    "year",
    "typescript",
    "i18n",
    "localization",
    "iso-week",
    "cache"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^1.3.1",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "typescript": "^5.8.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xaxouwells/remedy-calendar-fns.git"
  },
  "bugs": {
    "url": "https://github.com/xaxouwells/remedy-calendar-fns/issues"
  },
  "homepage": "https://github.com/xaxouwells/remedy-calendar-fns#readme"
}
